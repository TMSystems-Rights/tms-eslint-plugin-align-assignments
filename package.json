{
	"name": "@tms/eslint-plugin-align-assignments",
	"version": "1.0.0",
	"description": "TMS extension of assignment alignment for ESLint, with transparent comment-line support.",
	"license": "MIT",
	"author": "TMSystems-Rights",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TMSystems-Rights/tms-eslint-plugin-align-assignments.git"
	},
	"homepage": "https://github.com/TMSystems-Rights/tms-eslint-plugin-align-assignments#readme",
	"bugs": {
		"url": "https://github.com/TMSystems-Rights/tms-eslint-plugin-align-assignments/issues"
	},
	"main": "index.cjs",
