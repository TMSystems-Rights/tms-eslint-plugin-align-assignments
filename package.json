{
	"name": "@tms/eslint-plugin-align-assignments",
	"version": "1.0.3",
	"description": "TMS extension of assignment alignment for ESLint, with transparent comment-line support.",
	"license": "MIT",
	"author": "TMSystems-Rights",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TMSystems-Rights/tms-eslint-plugin-align-assignments.git"
	},
	"homepage": "https://github.com/TMSystems-Rights/tms-eslint-plugin-align-assignments#readme",
	"bugs": {
		"url": "https://github.com/TMSystems-Rights/tms-eslint-plugin-align-assignments/issues"
	},
	"main": "index.cjs",
	"types": "index.d.cts",
	"exports": {
		".": {
			"types": "./index.d.cts",
			"default": "./index.cjs"
		}
	},
	"files": [
		"index.cjs",
		"index.d.cts",
		"lib/",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"README.md"
	],
	"scripts": {
		"lint": "eslint .",
		"test": "node --test test/*.test.mjs",
		"test:types": "tsc --project test/types/tsconfig.json",
		"check": "npm run lint && npm test && npm run test:types",
		"pack:check": "npm pack --dry-run"
	},
	"engines": {
		"node": ">=18.18.0"
	},
	"peerDependencies": {
		"eslint": "^9.0.0 || ^10.0.0"
	},
	"devDependencies": {
		"@eslint/js": "9.39.2",
		"eslint": "9.39.2",
		"eslint10": "npm:eslint@10.11.0",
		"typescript": "5.9.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"alignment",
		"assignments"
	]
}
